{
  "name": "harcama-takip-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Firestore güvenlik kuralları testleri (Firebase Emulator gerektirir)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-harcama-rules \"node --test --test-concurrency=1 rules.test.js\"",
    "test:only": "node --test --test-concurrency=1 rules.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.3.0"
  }
}
