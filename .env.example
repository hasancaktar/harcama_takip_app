# Firebase & Uygulama Ortam Değişkenleri Örneği
# NOT: Bu dosya şablondur. Gerçek gizli anahtarları bu dosyaya yazmayınız.

# Firebase Emulator Ayarları (Lokal geliştirme için true yapabilirsiniz)
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=10.0.2.2 # Android emülatör için localhost eşleniği
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099
STORAGE_EMULATOR_PORT=9199
FUNCTIONS_EMULATOR_PORT=5001

# Uygulama Varsayılanları
DEFAULT_CURRENCY=TRY
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr_TR
