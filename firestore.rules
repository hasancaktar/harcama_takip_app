rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Kullanıcı Profili ve Cihaz Bildirim Token'ları
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 2. Takımlar
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read, write: if isAuthenticated();
      }

      match /invites/{inviteId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Collection Group Davetler
    match /{path=**}/invites/{inviteId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Harcamalar
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );

      allow create: if isAuthenticated() && 
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.amountInCents is int && 
        request.resource.data.amountInCents > 0;

      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // 4. Kredi Kartları
    match /creditCards/{cardId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.isSharedWithTeam == true
      );
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // 5. Taksit Planları
    match /installmentPlans/{planId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // 6. Bütçeler
    match /budgets/{budgetId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.visibility == "team"
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == "team"
      );
    }
  }
}
