rules_version = '2';

// Harcama Takip — Firestore güvenlik kuralları
//
// İlkeler:
//  1. Varsayılan olarak her şey kapalıdır; yalnızca açıkça izin verilen işlemler yapılabilir.
//  2. Profil dışındaki tüm veriler için e-posta adresi DOĞRULANMIŞ oturum gerekir.
//  3. Kişisel kayıtlar yalnızca sahibine, takım kayıtları yalnızca takım üyelerine açıktır.
//  4. Yazılan her belge şema ve boyut sınırlarıyla doğrulanır (istemci kodu ile aynı sınırlar).
//
// Testler: firestore-tests/ (Firebase Emulator ile `npm test`).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Yardımcılar

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    // Yönetici tarafından pasife alınan hesap hiçbir veriye erişemez
    // (kendi profilini okuyabilir; uygulama bununla uyarı gösterip çıkış yapar).
    function isDisabled() {
      return exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('disabled', false) == true;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true && !isDisabled();
    }

    // Yönetim paneli yetkisi: yalnızca bu e-posta adresi (doğrulanmış olmalı).
    // Aynı denetim Cloud Functions'ta da yapılır (functions/lib/notifications.js).
    function isAdmin() {
      return verified() && request.auth.token.email.lower() == 'hasancaktar@gmail.com';
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function teamData(teamId) {
      return get(teamPath(teamId)).data;
    }

    function isTeamMember(teamId) {
      return teamId is string && exists(teamPath(teamId)) && uid() in teamData(teamId).memberUids;
    }

    function isTeamOwner(teamId) {
      return teamId is string && exists(teamPath(teamId)) && teamData(teamId).ownerUid == uid();
    }

    function validPeriod(p) {
      return p is string && p.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function optionalString(d, field, maxLen) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= maxLen);
    }

    // Takım görünürlüğü tutarlılığı: kişisel kayıtta teamId olmamalı,
    // takım kaydında teamId kullanıcının üyesi olduğu bir takım olmalı.
    function validScope(d) {
      return d.visibility in ['personal', 'team']
        && (d.visibility == 'personal'
              ? d.get('teamId', null) == null
              : isTeamMember(d.get('teamId', null)));
    }

    // Not: Sorgu kurallarının (ör. teamId == X) değerlendirilebilmesi için alanlara
    // doğrudan erişilir; Firestore sorgu kısıtlarını bu ifadelerle eşleştirir.
    function canReadScoped(d) {
      return d.ownerUid == uid()
        || (d.visibility == 'team' && isTeamMember(d.teamId));
    }

    // ---------------------------------------------------------------- Kullanıcılar

    match /users/{userId} {
      // Profil, e-posta doğrulamasından önce de sahibince okunup yazılabilir (kayıt akışı).
      allow read: if (signedIn() && uid() == userId) || isAdmin();
      allow create: if signedIn() && uid() == userId
        && incoming().uid == userId
        && incoming().displayName is string && incoming().displayName.size() <= 60
        && !incoming().keys().hasAny(['disabled', 'disabledAt', 'disabledBy']);
      // Yönetici yalnızca pasif/aktif durumunu değiştirir; kendi hesabını pasife alamaz.
      allow update: if isAdmin() && uid() != userId
        && changedKeys().hasOnly(['disabled', 'disabledAt', 'disabledBy'])
        && incoming().disabled is bool;
      allow update: if signedIn() && uid() == userId
        && !changedKeys().hasAny(['disabled', 'disabledAt', 'disabledBy'])
        && incoming().get('uid', userId) == userId
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 60))
        && (!('fcmTokens' in incoming()) || (incoming().fcmTokens is list && incoming().fcmTokens.size() <= 20))
        && (!('pushEnabled' in incoming()) || incoming().pushEnabled is bool)
        && (!('language' in incoming()) || incoming().language in ['tr', 'en']);
      allow delete: if signedIn() && uid() == userId;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // ---------------------------------------------------------------- Yönetim

    // Kategoriler: herkes (doğrulanmış) okur, yalnızca yönetici yazar. Belge silinmez;
    // "silme" isDeleted=true ile yapılır ki geçmiş harcamalar kategorisini kaybetmesin.
    match /categories/{categoryId} {
      allow read: if verified();
      allow create, update: if isAdmin()
        && categoryId.matches('^[a-z0-9_]{2,40}$')
        && incoming().id == categoryId
        && incoming().nameTr is string && incoming().nameTr.size() > 0 && incoming().nameTr.size() <= 40
        && incoming().nameEn is string && incoming().nameEn.size() <= 40
        && incoming().iconKey is string && incoming().iconKey.size() <= 40
        && incoming().colorHex is string && incoming().colorHex.matches('^#[0-9A-Fa-f]{6}$')
        && incoming().isActive is bool
        && incoming().isDeleted is bool
        && incoming().order is int && incoming().order >= 0 && incoming().order <= 1000;
      allow delete: if false;
    }

    // Günlük hatırlatma ayarı: yalnızca yönetici. lastSentDate alanını sunucu yazar.
    match /appConfig/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && docId == 'dailyReminder'
        && incoming().enabled is bool
        && incoming().hour is int && incoming().hour >= 0 && incoming().hour <= 23
        && incoming().minute is int && incoming().minute >= 0 && incoming().minute <= 59
        && incoming().titleTr is string && incoming().titleTr.size() > 0 && incoming().titleTr.size() <= 80
        && incoming().bodyTr is string && incoming().bodyTr.size() > 0 && incoming().bodyTr.size() <= 240
        && incoming().titleEn is string && incoming().titleEn.size() <= 80
        && incoming().bodyEn is string && incoming().bodyEn.size() <= 240
        && incoming().target in ['all', 'selected']
        && incoming().targetUids is list && incoming().targetUids.size() <= 500
        && incoming().get('lastSentDate', null) == (resource == null ? null : resource.data.get('lastSentDate', null));
      allow delete: if false;
    }

    // Bildirim gönderimleri: yönetici yalnızca kuyruğa ekler; gönderimi ve sonuç
    // alanlarını Cloud Function (Admin SDK) yazar. İstemciden güncellenemez/silinemez.
    match /notificationCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().id == campaignId
        && incoming().type == 'manual'
        && incoming().status == 'queued'
        && incoming().createdBy == uid()
        && incoming().titleTr is string && incoming().titleTr.size() > 0 && incoming().titleTr.size() <= 80
        && incoming().bodyTr is string && incoming().bodyTr.size() > 0 && incoming().bodyTr.size() <= 240
        && incoming().titleEn is string && incoming().titleEn.size() <= 80
        && incoming().bodyEn is string && incoming().bodyEn.size() <= 240
        && incoming().target in ['all', 'selected']
        && incoming().targetUids is list && incoming().targetUids.size() <= 500
        && (incoming().target == 'all' || incoming().targetUids.size() > 0)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Yönetici işlem kayıtları: yalnızca eklenir, değiştirilemez ve silinemez.
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().adminUid == uid()
        && incoming().action is string && incoming().action.size() <= 60
        && incoming().summary is string && incoming().summary.size() <= 1000
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- Öneriler

    // Kullanıcı yalnızca kendi adına öneri ekler; yalnızca yönetici okur ve
    // "okundu" olarak işaretler.
    match /feedback/{feedbackId} {
      allow create: if verified()
        && incoming().keys().hasOnly(['id', 'uid', 'email', 'displayName', 'message',
                                      'appVersion', 'platform', 'status', 'createdAt'])
        && incoming().id == feedbackId
        && incoming().uid == uid()
        && incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 2000
        && incoming().email is string && incoming().email.size() <= 200
        && incoming().displayName is string && incoming().displayName.size() <= 60
        && incoming().appVersion is string && incoming().appVersion.size() <= 20
        && incoming().platform is string && incoming().platform.size() <= 20
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      // Kullanıcı kendi önerilerini okuyup silebilir (hesap silmede temizlenir).
      allow read, delete: if isAdmin() || (verified() && existing().uid == uid());
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status'])
        && incoming().status in ['new', 'read'];
    }

    // ---------------------------------------------------------------- Sürüm notları

    function validNoteList(l) {
      return l is list && l.size() <= 20;
    }

    match /releaseNotes/{version} {
      allow read: if verified();
      allow create, update: if isAdmin()
        && version.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && incoming().version == version
        && validNoteList(incoming().addedTr) && validNoteList(incoming().addedEn)
        && validNoteList(incoming().removedTr) && validNoteList(incoming().removedEn)
        && validNoteList(incoming().fixedTr) && validNoteList(incoming().fixedEn)
        && incoming().published is bool;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- Takımlar

    match /teams/{teamId} {
      allow read: if verified() && uid() in existing().memberUids;

      allow create: if verified()
        && incoming().ownerUid == uid()
        && incoming().memberUids == [uid()]
        && incoming().memberCount == 1
        && incoming().isArchived == false
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && optionalString(incoming(), 'description', 200);

      allow update: if verified() && (
        // Sahip: ad/açıklama/renk/arşiv güncelleyebilir ve üye çıkarabilir (üye ekleyemez, sahipliği devredemez).
        (existing().ownerUid == uid()
          && incoming().ownerUid == existing().ownerUid
          && uid() in incoming().memberUids
          && existing().memberUids.hasAll(incoming().memberUids)
          && changedKeys().hasOnly(['name', 'description', 'colorHex', 'isArchived', 'memberUids', 'memberCount', 'updatedAt'])
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
          && optionalString(incoming(), 'description', 200))
        ||
        // Davetle katılma: yalnızca kendini ekleyebilir; üye belgesi aynı yığında oluşturulmalıdır.
        (!(uid() in existing().memberUids)
          && existing().isArchived == false
          && incoming().memberUids == existing().memberUids.concat([uid()])
          && changedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())))
        ||
        // Ayrılma: sahip dışındaki üye yalnızca kendini çıkarabilir.
        (uid() in existing().memberUids
          && existing().ownerUid != uid()
          && incoming().memberUids == existing().memberUids.removeAll([uid()])
          && changedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']))
      );

      // Takımlar silinmez, arşivlenir (üyelerin kayıtları korunur).
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if verified() && isTeamMember(teamId);

        allow create: if verified()
          && memberUid == uid()
          && incoming().uid == memberUid
          && incoming().teamId == teamId
          && incoming().status == 'accepted'
          && (
            // Takımı oluşturan sahip kendi üyeliğini aynı yığında yazar.
            (incoming().role == 'owner'
              && !exists(teamPath(teamId))
              && getAfter(teamPath(teamId)).data.ownerUid == uid())
            ||
            // Davet edilen kişi, kendi e-postasına ait geçerli daveti kullanarak katılır.
            (incoming().role == 'member'
              && incoming().inviteId is string
              && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(incoming().inviteId)).data.status == 'pending'
              && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(incoming().inviteId)).data.invitedEmail == tokenEmail()
              && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(incoming().inviteId)).data.expiresAt > request.time)
          );

        // Üye yalnızca kendi görünen adını (displayName) güncelleyebilir.
        allow update: if verified()
          && memberUid == uid()
          && changedKeys().hasOnly(['displayName'])
          && incoming().displayName is string
          && incoming().displayName.size() <= 80;

        // Üye kendini çıkarabilir (sahip hariç); sahip başka üyeleri çıkarabilir.
        allow delete: if verified() && (
          (memberUid == uid() && !isTeamOwner(teamId))
          || (isTeamOwner(teamId) && memberUid != uid())
        );
      }

      match /invites/{inviteId} {
        allow read: if verified() && (isTeamOwner(teamId) || existing().invitedEmail == tokenEmail());

        allow create: if verified() && isTeamOwner(teamId)
          && teamData(teamId).isArchived == false
          && inviteId.matches('^[A-Z0-9]{8}$')
          && incoming().inviteId == inviteId
          && incoming().teamId == teamId
          && incoming().teamName is string && incoming().teamName.size() <= 60
          && incoming().invitedEmail is string
          && incoming().invitedEmail == incoming().invitedEmail.lower()
          && incoming().invitedEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && incoming().invitedEmail != tokenEmail()
          && incoming().role == 'member'
          && incoming().status == 'pending'
          && incoming().createdBy == uid()
          && incoming().expiresAt is timestamp
          && incoming().expiresAt > request.time
          && incoming().expiresAt < request.time + duration.value(8, 'd');

        allow update: if verified() && existing().status == 'pending' && (
          // Davet edilen kişi kabul eder (üye belgesi aynı yığında oluşmalı) veya reddeder.
          (existing().invitedEmail == tokenEmail()
            && changedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
            && (
              (incoming().status == 'accepted'
                && incoming().acceptedBy == uid()
                && existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())))
              || incoming().status == 'declined'
            ))
          ||
          // Sahip daveti iptal eder.
          (isTeamOwner(teamId) && changedKeys().hasOnly(['status']) && incoming().status == 'revoked')
        );

        allow delete: if verified() && isTeamOwner(teamId);
      }
    }

    // Kullanıcının kendi e-postasına gönderilmiş davetleri listelemesi (collectionGroup sorgusu).
    match /{path=**}/invites/{inviteId} {
      allow read: if verified() && resource.data.invitedEmail == tokenEmail();
    }

    // ---------------------------------------------------------------- Harcamalar

    // Akaryakıt harcamasının yakıt bilgileri (istemcideki FuelDetails sınırlarıyla aynı).
    function validFuel(f) {
      return f is map
        && f.keys().hasOnly(['type', 'liters', 'pricePerLiterCents', 'vehicleId', 'vehicleName',
                             'odometerKm', 'fullTank'])
        && f.type in ['gasoline', 'diesel', 'lpg']
        && f.liters is number && f.liters > 0 && f.liters <= 5000
        && f.pricePerLiterCents is int && f.pricePerLiterCents > 0 && f.pricePerLiterCents <= 100000
        && (f.get('vehicleId', null) == null || (f.vehicleId is string && f.vehicleId.size() <= 64))
        && optionalString(f, 'vehicleName', 40)
        && (f.get('odometerKm', null) == null
              || (f.odometerKm is int && f.odometerKm >= 0 && f.odometerKm <= 9999999))
        && f.fullTank is bool;
    }

    function validExpense(d, expenseId) {
      return d.keys().hasAll(['id', 'ownerUid', 'visibility', 'title', 'amountInCents', 'category',
                              'date', 'paymentMethod', 'statementPeriod', 'status', 'createdAt'])
        && d.id == expenseId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.amountInCents is int && d.amountInCents > 0 && d.amountInCents <= 10000000000
        && d.category is string && d.category.size() > 0 && d.category.size() <= 40
        && d.paymentMethod in ['cash', 'debit_card', 'credit_card', 'bank_transfer', 'auto_payment', 'other']
        && d.status in ['active', 'deleted']
        && validPeriod(d.statementPeriod)
        && optionalString(d, 'notes', 500)
        && optionalString(d, 'cardLast4', 4)
        && (d.get('fuel', null) == null || validFuel(d.fuel))
        && validScope(d);
    }

    match /expenses/{expenseId} {
      allow read: if verified() && canReadScoped(existing());

      allow create: if verified()
        && incoming().ownerUid == uid()
        && validExpense(incoming(), expenseId);

      // Yalnızca sahibi günceller (soft delete dahil); sahiplik devredilemez.
      allow update: if verified()
        && existing().ownerUid == uid()
        && incoming().ownerUid == existing().ownerUid
        && validExpense(incoming(), expenseId);

      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Araçlar

    // Yakıt takibi için araçlar: yalnızca sahibine açıktır.
    function validVehicle(d, vehicleId) {
      return d.keys().hasOnly(['id', 'ownerUid', 'name', 'brand', 'fuelType', 'odometerKm',
                               'createdAt', 'updatedAt'])
        && d.id == vehicleId
        && d.ownerUid == uid()
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && optionalString(d, 'brand', 40)
        && d.fuelType in ['gasoline', 'diesel', 'lpg']
        && (d.get('odometerKm', null) == null
              || (d.odometerKm is int && d.odometerKm >= 0 && d.odometerKm <= 9999999));
    }

    match /vehicles/{vehicleId} {
      allow read: if verified() && existing().ownerUid == uid();
      allow create: if verified() && validVehicle(incoming(), vehicleId);
      allow update: if verified()
        && existing().ownerUid == uid()
        && validVehicle(incoming(), vehicleId);
      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Kredi kartları

    function validCard(d, cardId) {
      return d.id == cardId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.bankName is string && d.bankName.size() > 0 && d.bankName.size() <= 60
        && d.last4Digits is string && d.last4Digits.matches('^[0-9]{4}$')
        && d.cutoffDay is int && d.cutoffDay >= 1 && d.cutoffDay <= 31
        && d.paymentDueDaysAfterCutoff is int && d.paymentDueDaysAfterCutoff >= 1 && d.paymentDueDaysAfterCutoff <= 60
        && d.limitInCents is int && d.limitInCents >= 0
        && d.isActive is bool
        && d.isSharedWithTeam is bool
        && (d.isSharedWithTeam == false || isTeamMember(d.get('teamId', null)));
    }

    match /creditCards/{cardId} {
      allow read: if verified() && (
        existing().ownerUid == uid()
        || (existing().isSharedWithTeam == true && isTeamMember(existing().teamId))
      );
      allow create: if verified() && incoming().ownerUid == uid() && validCard(incoming(), cardId);
      allow update: if verified()
        && existing().ownerUid == uid()
        && incoming().ownerUid == existing().ownerUid
        && validCard(incoming(), cardId);
      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Banka kartları

    // Banka kartları yalnızca sahibine açıktır (takımla paylaşılmaz).
    function validDebitCard(d, cardId) {
      return d.keys().hasOnly(['id', 'ownerUid', 'name', 'bankName', 'last4Digits', 'colorHex',
                               'isActive', 'createdAt', 'updatedAt'])
        && d.id == cardId
        && d.ownerUid == uid()
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.bankName is string && d.bankName.size() > 0 && d.bankName.size() <= 60
        && d.last4Digits is string && d.last4Digits.matches('^[0-9]{4}$')
        && optionalString(d, 'colorHex', 9)
        && d.isActive is bool;
    }

    match /debitCards/{cardId} {
      allow read: if verified() && existing().ownerUid == uid();
      allow create: if verified() && validDebitCard(incoming(), cardId);
      allow update: if verified()
        && existing().ownerUid == uid()
        && validDebitCard(incoming(), cardId);
      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Taksit planları

    function validPlan(d, planId) {
      return d.id == planId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.totalAmountInCents is int && d.totalAmountInCents > 0 && d.totalAmountInCents <= 10000000000
        && d.totalInstallments is int && d.totalInstallments >= 1 && d.totalInstallments <= 120
        && d.installmentSchedule is list && d.installmentSchedule.size() == d.totalInstallments
        && d.status in ['active', 'completed', 'cancelled']
        && d.cardId is string
        && validScope(d);
    }

    match /installmentPlans/{planId} {
      allow read: if verified() && canReadScoped(existing());
      allow create: if verified() && incoming().ownerUid == uid() && validPlan(incoming(), planId);
      allow update: if verified()
        && existing().ownerUid == uid()
        && incoming().ownerUid == existing().ownerUid
        && validPlan(incoming(), planId);
      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Otomatik ödemeler

    function validRecurring(d, paymentId) {
      return d.id == paymentId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.amountInCents is int && d.amountInCents > 0 && d.amountInCents <= 10000000000
        && d.category is string && d.category.size() > 0 && d.category.size() <= 40
        && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31
        && d.status in ['active', 'cancelled']
        && (d.get('cardId', null) == null || d.cardId is string)
        && optionalString(d, 'cardLast4', 4)
        && (d.get('lastPostedMonth', null) == null || validPeriod(d.lastPostedMonth))
        && optionalString(d, 'notes', 500)
        && validScope(d);
    }

    match /recurringPayments/{paymentId} {
      allow read: if verified() && canReadScoped(existing());
      allow create: if verified() && incoming().ownerUid == uid() && validRecurring(incoming(), paymentId);
      allow update: if verified()
        && existing().ownerUid == uid()
        && incoming().ownerUid == existing().ownerUid
        && validRecurring(incoming(), paymentId);
      allow delete: if verified() && existing().ownerUid == uid();
    }

    // ---------------------------------------------------------------- Bütçeler

    function validBudget(d, budgetId) {
      return d.id == budgetId
        && validPeriod(d.period)
        && d.totalBudgetInCents is int && d.totalBudgetInCents > 0 && d.totalBudgetInCents <= 10000000000
        && d.categoryBudgetsInCents is map && d.categoryBudgetsInCents.size() <= 30
        && d.ownerUid == uid()
        && validScope(d)
        // Her çalışma alanı + dönem için tek belge (deterministik kimlik).
        && budgetId == (d.visibility == 'team'
              ? 'team_' + d.teamId + '_' + d.period
              : 'user_' + uid() + '_' + d.period)
        // Takım bütçesini yalnızca takımı kuran kişi belirler.
        && (d.visibility == 'personal' || isTeamOwner(d.teamId));
    }

    match /budgets/{budgetId} {
      allow read: if verified() && canReadScoped(existing());
      allow create: if verified() && validBudget(incoming(), budgetId);
      allow update: if verified()
        && validBudget(incoming(), budgetId)
        && existing().visibility == incoming().visibility
        && (existing().visibility == 'team' || existing().ownerUid == uid());
      // Eski sürümlerden kalan, kimliği kanonik olmayan kayıtlar da aynı kurala tabidir:
      // kişisel bütçeyi sahibi, takım bütçesini takımı kuran kişi siler.
      allow delete: if verified() && (
        (existing().visibility == 'personal' && existing().ownerUid == uid())
        || (existing().visibility == 'team' && isTeamOwner(existing().get('teamId', null)))
      );
    }
  }
}
